{
  "name": "fn-music-player",
  "version": "2.1.4",
  "description": "咔一下子音乐 · 桌面播放器（独立 exe，兼容飞牛音乐）",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --arm64 --x64",
    "serve:lib": "node server.cjs",
    "docker:build": "docker build -f docker/Dockerfile -t fn-music-web:2.0.0 .",
    "docker:save": "docker save fn-music-web:2.0.0 | gzip > fn-music-web-2.0.0.tar.gz"
  },
  "author": "junze",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.junze.fnmusic",
    "productName": "咔一下子音乐",
    "asar": true,
    "files": [
      "electron-main.js",
      "preload.js",
      "server.cjs",
      "library.cjs",
      "downloader.cjs",
      "bt-smtc.cjs",
      "index.html",
      "icon.ico",
      "icon_512.png",
      "config.local.example.json",
      "config.local.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "咔一下子音乐",
      "artifactName": "咔一下子音乐-${version}-安装程序.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icon.png",
      "category": "public.app-category.music",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "artifactName": "KaYiXiaZiMusic-${version}-${arch}.dmg"
    },
    "dmg": {
      "title": "FnMusicPlayer ${version}",
      "contents": [
        {
          "x": 150,
          "y": 200
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "music-metadata": "^12.3.3"
  }
}